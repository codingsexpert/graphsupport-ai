# ==============================================================================
# GraphSupport AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#
# DO NOT store real production secrets or API keys in this template.
# .env is ignored by version control.
# ==============================================================================

# Core Application Settings
APP_NAME="GraphSupport AI"
APP_ENV="development"              # Options: development | testing | production
LOG_LEVEL="INFO"                   # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# Streamlit UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Neo4j Graph Database (Reserved for Phase 2)
# Not required for Phase 1 application startup or unit tests.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="dummy_neo4j_password_for_local_dev"
NEO4J_DATABASE="neo4j"

# LLM Provider Configuration
LLM_PROVIDER="google"              # Options: google | openai | sarvam | mock
LLM_API_KEY="dummy_api_key_for_testing"
LLM_MODEL="gemini-2.0-flash"

# Sarvam AI Configuration (Indian LLM & Multilingual Provider)
# Set LLM_PROVIDER="sarvam" to activate
SARVAM_API_KEY="dummy_sarvam_api_key"
SARVAM_MODEL="sarvam-105b"          # Options: sarvam-105b | sarvam-2b
SARVAM_BASE_URL="https://api.sarvam.ai/v1"

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=false            # Set to true to trace agent runs and tool executions
LANGSMITH_API_KEY="dummy_lsv2_pt_key"
LANGSMITH_PROJECT="graphsupport-ai"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
